        "/api/comandes/entre-dates": {
            "get": {
                "tags": [
                    "Comandes"
                ],
                "summary": "Obté les comandes entre dues dates",
                "description": "Retorna les comandes entre dues dates, incloent els detalls de la comanda i els productes",
                "operationId": "1c3701cfdbb6ed55e8b369a94aa67b03",
                "parameters": [
                    {
                        "name": "inici",
                        "in": "query",
                        "description": "Data inicial (YYYY-MM-DD)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "fi",
                        "in": "query",
                        "description": "Data final (YYYY-MM-DD)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Llista de comandes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "exit": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "dades": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "data": {
                                                        "type": "string",
                                                        "format": "date-time"
                                                    },
                                                    "tipus": {
                                                        "type": "string"
                                                    },
                                                    "detalls_comanda": {
                                                        "type": "array",
                                                        "items": {
                                                            "properties": {
                                                                "quantitat": {
                                                                    "type": "integer"
                                                                },
                                                                "producte": {
                                                                    "properties": {
                                                                        "nom": {
                                                                            "type": "string"
                                                                        },
                                                                        "referencia": {
                                                                            "type": "string"
                                                                        }
                                                                    },
                                                                    "type": "object"
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
